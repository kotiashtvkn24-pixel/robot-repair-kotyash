<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:VisualElement name="StartScreenContainer" style="display: none; position: absolute; top: 0; right: 0; bottom: 0; left: 0; padding-left: 24px; padding-right: 24px; background-color: rgba(20, 15, 35, 0.95); align-items: center; justify-content: center;">
        <ui:Label text="Robot Repair" style="font-size: 72px; -unity-font-style: bold; color: rgb(255, 239, 211); -unity-text-align: middle-center; white-space: normal;" />
        <ui:Label text="Полагодь усі п’ять торгових автоматів.&#10;Рух — WASD або стрілки · C — шестерня · X — розмова" style="font-size: 34px; color: rgb(255, 248, 237); margin-top: 16px; -unity-text-align: middle-center; white-space: normal;" />
        <ui:Button name="StartScreenContainerButton" text="Грати" style="font-size: 34px; -unity-font-style: bold; width: 360px; height: 72px; margin-top: 42px; background-color: rgb(255, 215, 157); color: rgb(30, 19, 42);" />
    </ui:VisualElement>
    <ui:VisualElement name="LoseScreenContainer" style="display: none; position: absolute; top: 0; right: 0; bottom: 0; left: 0; padding-left: 24px; padding-right: 24px; background-color: rgba(20, 15, 35, 0.95); align-items: center; justify-content: center;">
        <ui:Label text="Поразка" style="font-size: 72px; -unity-font-style: bold; color: rgb(255, 239, 211); -unity-text-align: middle-center; white-space: normal;" />
        <ui:VisualElement name="LoseScreen" picking-mode="Ignore" style="width: 90%; max-width: 840px; height: 48%; margin-top: 12px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/Demo_Art/Common/LoseScreen.png?fileID=2800000&amp;guid=68999694f4e00437a8c4f0b6053e3d45&amp;type=3#LoseScreen&quot;);" />
        <ui:Label text="Здоров’я робота вичерпано." style="font-size: 34px; color: rgb(255, 248, 237); margin-top: 16px; -unity-text-align: middle-center; white-space: normal;" />
        <ui:Button name="LoseScreenContainerButton" text="Спробувати ще" style="font-size: 34px; -unity-font-style: bold; width: 360px; height: 72px; margin-top: 42px; background-color: rgb(255, 215, 157); color: rgb(30, 19, 42);" />
    </ui:VisualElement>
    <ui:VisualElement name="WinScreenContainer" style="display: none; position: absolute; top: 0; right: 0; bottom: 0; left: 0; padding-left: 24px; padding-right: 24px; background-color: rgba(20, 15, 35, 0.95); align-items: center; justify-content: center;">
        <ui:Label text="Перемога" style="font-size: 72px; -unity-font-style: bold; color: rgb(255, 239, 211); -unity-text-align: middle-center; white-space: normal;" />
        <ui:VisualElement name="WinScreen" picking-mode="Ignore" style="width: 90%; max-width: 840px; height: 48%; margin-top: 12px; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/_2DAdventureGame/Tutorial_Demo/Demo_Art/Common/WinScreen.png?fileID=-848381713617584042&amp;guid=d46766d63d5ca44c6b1a4d318b1eaf72&amp;type=3#WinScreen_0&quot;);" />
        <ui:Label text="Усі автомати полагоджено." style="font-size: 34px; color: rgb(255, 248, 237); margin-top: 16px; -unity-text-align: middle-center; white-space: normal;" />
        <ui:Button name="WinScreenContainerButton" text="Зіграти ще" style="font-size: 34px; -unity-font-style: bold; width: 360px; height: 72px; margin-top: 42px; background-color: rgb(255, 215, 157); color: rgb(30, 19, 42);" />
    </ui:VisualElement>
</ui:UXML>
